# Beispiel .env - trage hier deine Keys / Base-URLs ein

# Ollama (lokal)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODELS=llama2

# OpenAI (API)
OPENAI_API_KEY=sk-...
OPENAI_MODELS=gpt-4o-mini,gpt-4o

# IONOS (API)
IONOS_API_KEY=your_ionos_api_key
IONOS_BASE_URL=https://api.ionos.ai
IONOS_MODELS=ionos-model-1,ionos-model-2

# AWS (Cloud API / Bedrock) - wenn über REST/Proxy erreichbar
AWS_BASE_URL=https://your-bedrock-endpoint
AWS_MODELS=amazon.titan-small

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODELS=claude-2.1,claude-3

# Google Gemini (Cloud)
GEMINI_API_KEY=your_gemini_key
GEMINI_BASE_URL=https://api.google.com/gemini
GEMINI_MODELS=gemini-1.0,gemini-pro

# Optional: Standard-Prompts (Komma-separiert für schnelle Tests)
DEFAULT_PROMPTS="Schreibe einen kurzen Absatz (2-3 Sätze) über KI auf Deutsch.","Erläutere in einem Satz, was maschinelles Lernen ist."